# ============================================================
# yiye-agent .env 模板
# ============================================================
# 复制本文件为 .env 并填入真实值:
#   cp .env.example .env       (macOS/Linux)
#   copy .env.example .env     (Windows)
#
# ⚠️ .env 已在 .gitignore 中, 不会被提交到 Git
# ⚠️ 不要把 .env 上传到云盘/iCloud/备份盘
# ⚠️ 如果 key 泄露, 立即去 rightapi 控制台撤销并重新签发
# ============================================================

# --- LLM API ---
# rightapi Responses API, key 从 rightapi 控制台获取
RIGHTAPI_API_KEY=your-api-key-here

# 可选: 自定义 API 端点 (默认 rightapi Responses endpoint)
# RIGHTAPI_BASE_URL=https://www.rightapi.ai/codex/v1/responses

# --- 内部 API 鉴权 (P0-4) ---
# UI server 的 /api/* 端点鉴权 token.
# 不配置则使用 dev default (会打 WARNING, 上线必须改).
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 调用方: HTTP header `X-Internal-Token: <上面生成的值>`
INTERNAL_API_TOKEN=
