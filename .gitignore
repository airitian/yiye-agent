# ============================================================
# AI 测试用例生成系统 - .gitignore
# 第一个文件，杜绝任何敏感信息进 Git
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# 虚拟环境
venv/
env/
.venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# 【关键】敏感信息 - 永远不进 Git
# ============================================================

# 环境变量文件
.env
.env.*
*.env

# 任何包含 key/token/secret 的文件
*.key
*.token
*.secret
*credentials*
*secrets*

# 任何包含完整 token 的备份
api_keys.txt
token_backup*
tokens.*

# LLM 调用日志（可能包含敏感数据）
.llm_logs/
llm_raw_responses/

# ============================================================
# 运行时生成的数据（不需要进 Git）
# ============================================================

# 工作区运行数据
.runs/
runs/*/logs/
runs/*/tmp/

# 知识库运行时数据
.state/
*.db
*.db-journal
*.db-wal
*.db-shm

# 向量库数据
.vectors/
*.chroma/
*.qdrant/

# 构建产物
_build/
build/

# LLM 调用原始响应（可能含敏感数据）
.llm_raw/

# ============================================================
# 用户特定
# ============================================================

# 用户本地配置覆盖
config.local.yaml
config.local.yml

# 测试数据
test_data/
fixtures/local/

# ============================================================
# 日志（运行时生成，可能含敏感信息）
# ============================================================

# 运行时日志
*.log
logs/
.logs/

# 审计日志（可选择是否进 Git，建议 .gitignore）
# .audit/

# ============================================================
# 临时文件
# ============================================================

*.tmp
*.bak
*.swp
*~
.cache/

# ============================================================
# yiye-agent 上传 GitHub 补充规则 (2026-07-08)
# ============================================================

# 任务运行数据 (含 LLM 调用历史)
runs/

# 业务需求样本 (portfolio 不应含内部业务需求)
requirements/

# 已建好的业务代码索引 (含真实业务代码片段 + 审计清单)
# 用户运行 `testcase kb build` 自行重建
domains/

# UI 临时页面快照
.tmp/

# 调试/验证残留
_verify_*.js
_*.py
.tmp_repro.py
r.status)
ERR
'ERR
'*'

# 工作区任务数据库
*.task.db
task.db